#!/usr/bin/env bash
# gg is an advisory reviewer for work that is about to leave a developer's machine.
# Checks own analysis only; this file owns file selection, isolation, presentation,
# and the distinction between an advisory review and the narrow publication gate.
set -euo pipefail
IFS=$'\n\t'

GG_VERSION="3.0.3"
GG_JSON=false
GG_FULL=false
GG_TIMEOUT=120
GG_UPDATE='{"status":"unknown"}'

_resolve_self_dir() {
  local self
  self=$(realpath "$0" 2>/dev/null || printf '%s\n' "$0")
  dirname "$self"
}

GG_SELF_DIR=$(_resolve_self_dir)
GG_CHECKS_DIR="$GG_SELF_DIR/checks"
GG_INVOKE_DIR=$PWD
COLOR=false
if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
  COLOR=true
fi

usage() {
  cat <<'EOF'
Usage:
  gg                              Review the current branch against its base
  gg <path>...                    Review tracked and untracked non-ignored files
  gg --staged [-- <pathspec>...]  Review staged files, optionally scoped
  gg --since <ref>                Review the current branch against <ref>
  gg guard pre-push [-- <pathspec>...]
                                  Block scoped push-range secrets and large files
  gg setup                       Install pinned review runners explicitly
  gg --json [review arguments]    Emit structured check results (requires jq)
  gg --full [...]                Show every finding (default first 100 per check)
  gg --timeout SECONDS [...]      Per-check limit (default 120, GNU timeout)
  gg self-update                  Install the latest stable release
  gg --version                    Print the installed version
  gg --help                       Show this help

Exit status: 0 completed (findings are advisory), 1 incomplete execution.

Examples:
  gg --staged -- src/
  gg --json --since origin/main
  NO_COLOR=1 gg --timeout 60 src/
EOF
}

report_error() {
  local code=$1 message=$2 status=$3
  if $GG_JSON && command -v jq >/dev/null 2>&1; then
    jq -cn --arg code "$code" --arg message "$message" '{schema_version:1,error:{code:$code,message:$message},help:["gg --help"]}'
  else
    printf 'gg: %s\nhelp: gg --help\n' "$message" >&2
  fi
  return "$status"
}

fail_usage() {
  report_error usage "$1" 2
}

operation() {
  local name=$1 status=0
  shift
  if $GG_JSON; then
    "$@" >&2 || status=$?
    if [[ $status -eq 130 || $status -eq 143 ]]; then return "$status"; fi
    if [[ $status -ne 0 ]]; then
      report_error "$name" "$name failed; see stderr diagnostics, correct the cause, and rerun gg $name" 1
      return 1
    fi
    jq -cn --arg name "$name" '{schema_version:1,operation:$name,status:"completed",help:(if $name == "self-update" then ["gg setup"] else ["gg --json --staged"] end)}'
  else
    "$@" || return 1
    if [[ "$name" == self-update ]]; then printf 'next: gg setup\n'; else printf 'next: gg --staged\n'; fi
  fi
}

resolve_base() {
  local base candidate merge_base
  if [[ -n "${GG_BASE:-}" ]]; then
    base=$GG_BASE
  else
    base=$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null || true)
    if [[ -z "$base" ]]; then
      for candidate in origin/main origin/master origin/develop; do
        if git rev-parse --verify --quiet "$candidate" >/dev/null; then
          base=$candidate
          break
        fi
      done
    fi
    if [[ -z "$base" ]] && git rev-parse --verify --quiet HEAD~1 >/dev/null; then
      base=HEAD~1
    fi
  fi

  [[ -n "${base:-}" ]] || return 1
  git rev-parse --verify --quiet "$base" >/dev/null || return 1
  if ! git merge-base --is-ancestor "$base" HEAD 2>/dev/null; then
    merge_base=$(git merge-base "$base" HEAD 2>/dev/null || true)
    [[ -n "$merge_base" ]] || return 1
    base=$merge_base
  fi
  printf '%s\n' "$base"
}

repo_root() {
  git rev-parse --show-toplevel 2>/dev/null || {
    printf 'gg: not inside a git worktree\n' >&2
    exit 1
  }
}

existing_files() {
  local file
  while IFS= read -r file; do
    [[ -n "$file" && ( "$GG_MODE" == staged || -f "$GG_ROOT/$file" ) ]] && printf '%s\n' "$file"
  done | sort -u
}

# GG_RANGE is a rev-list expression, not always a two-dot range: the first push
# of a new branch has no remote counterpart, so the only honest description of
# what is being published is "everything reachable from this ref that no other
# remote ref already has". Splitting on spaces needs an explicit local IFS
# because this script sets a global IFS of newline+tab.
range_args() {
  local IFS=' '
  read -r -a "$1" <<< "$GG_RANGE"
}

collect_files() {
  case "$GG_MODE" in
    branch)
      {
        git -c core.quotePath=false diff --name-only --diff-filter=ACMR "$GG_BASE...HEAD"
        git -c core.quotePath=false diff --name-only --diff-filter=ACMR HEAD
      } | existing_files
      ;;
    staged)
      if [[ ${#GG_PATHS[@]} -gt 0 ]]; then
        git -C "$GG_INVOKE_DIR" -c core.quotePath=false diff --no-relative \
          --name-only --cached --diff-filter=ACMR -- "${GG_PATHS[@]}"
      else
        git -c core.quotePath=false diff --name-only --cached --diff-filter=ACMR
      fi | existing_files
      ;;
    paths)
      git -C "$GG_INVOKE_DIR" -c core.quotePath=false ls-files \
        --cached --others --exclude-standard --full-name -- "${GG_PATHS[@]}" | existing_files
      ;;
    range)
      local -a rargs=()
      range_args rargs
      if [[ ${#GG_PATHS[@]} -gt 0 ]]; then
        git -C "$GG_INVOKE_DIR" -c core.quotePath=false log --no-relative \
          --name-only --pretty=format: --diff-filter=ACMR \
          "${rargs[@]}" -- "${GG_PATHS[@]}"
      else
        git -c core.quotePath=false log --name-only --pretty=format: \
          --diff-filter=ACMR "${rargs[@]}"
      fi | sed '/^$/d' | sort -u
      ;;
  esac
}

check_files() {
  local check=$1 globs_line file glob base matched
  globs_line=$(sed -n 's/^# gg-globs:[[:space:]]*//p' "$check" | sed -n '1p')
  [[ -n "$globs_line" ]] || return 0
  while IFS= read -r file; do
    base=${file##*/}
    matched=false
    local -a globs=()
    IFS=' ' read -r -a globs <<< "$globs_line"
    for glob in "${globs[@]}"; do
      if [[ "$base" == $glob ]]; then
        matched=true
        break
      fi
    done
    $matched && printf '%s\n' "$file"
  done <<< "$GG_ALL_FILES"
}

style_heading() {
  if $COLOR; then
    printf '\033[1m%s\033[0m\n' "$1"
  else
    printf '%s\n' "$1"
  fi
}

render_check() {
  local name=$1 output=$2 status=$3
  style_heading "$name"
  if [[ $status -eq 4 ]]; then
    printf '  (not applicable: %s)\n' "$output"
  elif [[ $status -eq 2 ]]; then
    printf '  (skipped: %s)\n' "${output:-required tool unavailable}"
  elif [[ $status -ne 0 ]]; then
    printf '  (error: %s)\n' "${output:-check exited with status $status}"
  else
    while IFS= read -r line; do
      [[ -n "$line" ]] && printf '  %s\n' "$line"
    done <<< "$output"
  fi
}

run_checks() {
  local guard=$1 check name files output status line_count check_root
  local findings=0 ran_checks=0 skipped=0 not_applicable=0 errors=0 blocked=0 runner_pid=""
  local -a checks=()
  local scratch timeout_bin snapshot_failure="" unheld
  local GG_BASE=$GG_BASE
  if [[ "$GG_MODE" == staged ]]; then GG_BASE=$(git rev-parse --verify HEAD 2>/dev/null || true); fi
  scratch=$(mktemp -d) || return 1
  cleanup() {
    if [[ -n "$runner_pid" ]]; then
      kill -TERM "$runner_pid" 2>/dev/null || true
      wait "$runner_pid" 2>/dev/null || true
    fi
    rm -rf "$scratch"
  }
  trap cleanup EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  timeout_bin=$(command -v timeout || command -v gtimeout || true)
  : >"$scratch/results"
  if $guard; then
    for check in "$GG_CHECKS_DIR/secrets.sh" "$GG_CHECKS_DIR/large-files.sh"; do
      [[ -f "$check" ]] && checks+=("$check")
    done
  elif [[ -d "$GG_CHECKS_DIR" ]]; then
    while IFS= read -r check; do checks+=("$check"); done < <(find "$GG_CHECKS_DIR" -maxdepth 1 -type f -name '*.sh' -print | sort)
  fi
  check_root=$GG_ROOT
  : >"$scratch/unheld"
  if [[ "$GG_MODE" == staged && -n "$timeout_bin" ]]; then
    local snapshot_status=0
    "$timeout_bin" --kill-after=2 "$GG_TIMEOUT" "${BASH:-bash}" "$GG_SELF_DIR/snapshot.sh" "$GG_ROOT" "$scratch/tree" >"$scratch/unheld" 2>"$scratch/snapshot-error" &
    runner_pid=$!
    wait "$runner_pid" || snapshot_status=$?
    runner_pid=""
    if [[ $snapshot_status -eq 0 ]]; then
      check_root="$scratch/tree"
    else
      check_root=""
      if [[ $snapshot_status -eq 124 || $snapshot_status -eq 137 ]]; then
        snapshot_failure="snapshot exceeded $GG_TIMEOUT seconds"
      else
        snapshot_failure=$(sed '/^[[:space:]]*$/d' "$scratch/snapshot-error" | tail -n 1 | cut -c 1-500)
        snapshot_failure=${snapshot_failure:-snapshot exited with status $snapshot_status}
      fi
    fi
  fi
  # Indexed paths the snapshot's filesystem could not hold separately, such as
  # a case-only pair on case-insensitive APFS. Whole-repository checks lose
  # their context silently otherwise, so the omission is always stated.
  if [[ -n "$check_root" && -s "$scratch/unheld" ]]; then
    printf 'gg: staged snapshot cannot hold %s indexed path(s) beside a same-named path on this filesystem: %s\n' \
      "$(wc -l <"$scratch/unheld" | tr -d ' ')" "$(sed -n '1,5p' "$scratch/unheld" | paste -sd ',' - | sed 's/,/, /g')" >&2
  fi

  for check in "${checks[@]}"; do
    files=$(check_files "$check")
    [[ -n "$files" ]] || continue
    name=${check##*/}; name=${name%.sh}
    : >"$scratch/output"
    status=0
    if [[ -z "$check_root" ]]; then
      printf 'cannot materialize the Git index: %s\n' "$snapshot_failure" >"$scratch/output"
      status=3
    elif [[ -s "$scratch/unheld" ]] && unheld=$(printf '%s\n' "$files" | grep -Fx -f "$scratch/unheld"); then
      # Reviewing another entry's bytes under this name would be a false result.
      printf 'cannot review %s: the staged snapshot holds another indexed path with the same name on this filesystem\n' \
        "$(printf '%s\n' "$unheld" | paste -sd ',' - | sed 's/,/, /g')" >"$scratch/output"
      status=3
    elif [[ -z "$timeout_bin" ]]; then
      printf '%s\n' 'GNU timeout is required; install coreutils' >"$scratch/output"
      status=2
    else
      (
        # Hook-local routing must not redirect a check's temporary Git repositories.
        while IFS= read -r git_env_name; do unset "$git_env_name"; done \
          < <(git rev-parse --local-env-vars)
        cd "$check_root" || exit 3
        export GG_ROOT="$check_root" GG_INVOKE_DIR GG_BASE GG_RANGE GG_LOCAL_REF GG_MODE GG_FILES="$files"
        if [[ "$GG_MODE" == staged ]]; then export GG_INVOKE_DIR="$check_root" GG_BASE="$(git rev-parse --verify HEAD 2>/dev/null || true)"; fi
        set --
        if [[ ${#GG_PATHS[@]} -gt 0 ]]; then set -- -- "${GG_PATHS[@]}"; fi
        exec "$timeout_bin" --kill-after=2 "$GG_TIMEOUT" "${BASH:-bash}" "$check" "$@"
      ) >"$scratch/output" 2>"$scratch/error" &
      runner_pid=$!
      wait "$runner_pid" || status=$?
      runner_pid=""
      if [[ $status -eq 124 || $status -eq 137 ]]; then
        printf 'check exceeded %s seconds\n' "$GG_TIMEOUT" >"$scratch/output"
        status=3
      elif [[ $status -ne 0 && ! -s "$scratch/output" ]]; then
        tail -c 1000 "$scratch/error" >"$scratch/output"
      fi
    fi
    output=$(cat "$scratch/output")
    local result_status=completed
    if [[ $status -eq 4 && "$guard" == false ]]; then
      result_status=not_applicable; not_applicable=$((not_applicable + 1))
    elif [[ $status -eq 2 ]]; then
      result_status=skipped; skipped=$((skipped + 1)); $guard && blocked=1
    elif [[ $status -ne 0 ]]; then
      result_status=error; errors=$((errors + 1)); blocked=1
    else
      ran_checks=$((ran_checks + 1))
      line_count=$(printf '%s\n' "$output" | sed '/^$/d' | wc -l | tr -d ' ')
      findings=$((findings + line_count))
      [[ $line_count -gt 0 ]] && blocked=1
    fi
    local shown_output="$scratch/output" omitted=0
    if [[ $status -eq 0 ]] && ! $GG_FULL && [[ $line_count -gt 100 ]]; then
      sed -n '1,100p' "$scratch/output" >"$scratch/preview"
      shown_output="$scratch/preview"
      omitted=$((line_count - 100))
    fi
    if ! $GG_FULL; then
      if awk 'length($0)>1000 {print substr($0,1,1000) " (truncated, " length($0) " chars; use --full)"; next} {print}' "$shown_output" >"$scratch/bounded"; then
        shown_output="$scratch/bounded"
      fi
    fi
    if $GG_JSON; then
      jq -cn --arg name "$name" --arg status "$result_status" --argjson omitted "$omitted" --rawfile output "$shown_output" \
        '{name:$name,status:$status} + (if $status == "completed" then {findings:($output|split("\n")|map(select(length>0)))} else {reason:($output|rtrimstr("\n"))} end) + (if $omitted > 0 then {omitted:$omitted,help:["gg --full with the same review arguments"]} else {} end)' >>"$scratch/results"
    elif [[ -n "$output" || $status -ne 0 ]]; then
      printf '\n'; render_check "$name" "$(cat "$shown_output")" "$status"
      [[ $omitted -gt 0 ]] && printf '  (%s findings omitted; rerun with --full)\n' "$omitted"
    fi
  done
  if $GG_JSON; then
    jq -cs --arg bin "$GG_SELF_DIR/gg" --arg description "Review Git changes with independent static checks" --argjson update "$GG_UPDATE" --arg mode "$GG_MODE" --arg base "$GG_BASE" --argjson findings "$findings" --argjson completed "$ran_checks" --argjson skipped "$skipped" --argjson errors "$errors" --argjson not_applicable "$not_applicable" \
      '{schema_version:1,bin:$bin,description:$description,mode:$mode,base:$base,update:$update,checks:.,summary:{findings:$findings,completed:$completed,skipped:$skipped,errors:$errors,not_applicable:$not_applicable,coverage_complete:($skipped==0 and $errors==0)},help:(if $skipped>0 then ["gg setup, then rerun the same review"] elif $errors>0 then ["Resolve check errors, then rerun the same review"] elif $findings>0 then ["Inspect reported locations; rerun with the same arguments after changes", "gg --full with the same review arguments"] else ["Run the repository test suite; gg does not execute tests"] end)}' "$scratch/results"
  else
    printf '\n%s findings across %s checks' "$findings" "$ran_checks"
    [[ $not_applicable -gt 0 ]] && printf ' · %s not applicable' "$not_applicable"
    [[ $skipped -gt 0 ]] && printf ' · %s skipped' "$skipped"
    [[ $errors -gt 0 ]] && printf ' · %s errors' "$errors"
    [[ $skipped -gt 0 || $errors -gt 0 ]] && printf ' · coverage incomplete'
    printf '\n'
    if [[ $skipped -gt 0 ]]; then printf 'next: gg setup, then rerun the same review\n';
    elif [[ $errors -gt 0 ]]; then printf 'next: resolve check errors, then rerun the same review\n';
    elif [[ $findings -gt 0 ]]; then printf 'next: inspect reported locations, then rerun the same review; use --full for all findings\n';
    else printf 'next: run the repository test suite; gg does not execute tests\n'; fi
  fi
  cleanup
  trap - EXIT INT TERM
  if $guard && [[ $blocked -ne 0 ]]; then return 1; fi
  if [[ $skipped -gt 0 || $errors -gt 0 ]]; then return 1; fi
  return 0
}

review() {
  local label count display_bin="$GG_SELF_DIR/gg"
  [[ "$display_bin" == "$HOME/"* ]] && display_bin="~${display_bin#$HOME}"
  GG_ROOT=$(repo_root) || { report_error repository "Run gg inside a Git working tree" 1; return 1; }
  cd "$GG_ROOT"
  GG_ALL_FILES=$(collect_files) || { report_error git "Could not select review files; verify the Git ref and pathspec" 1; return 1; }
  if [[ -f "$GG_SELF_DIR/update-check.sh" && -z "${CI:-}" ]]; then
    GG_UPDATE=$("${BASH:-bash}" "$GG_SELF_DIR/update-check.sh" "$GG_SELF_DIR")
    if ! $GG_JSON && [[ "$GG_UPDATE" == *'"status":"available"'* ]]; then
      printf 'gg: update available; run gg self-update\n' >&2
    fi
  fi
  count=0
  if [[ -n "$GG_ALL_FILES" ]]; then
    count=$(printf '%s\n' "$GG_ALL_FILES" | wc -l | tr -d ' ')
  fi
  case "$GG_MODE" in
    branch) label="branch vs $GG_BASE" ;;
    staged) label=staged ;;
    paths) label=paths ;;
    range) label="range $GG_RANGE" ;;
  esac
  if ! $GG_JSON; then
    printf 'bin: %s\ndescription: Review Git changes with independent static checks\n' "$display_bin"
  fi
  $GG_JSON || printf 'gg  %s  (%s file%s)\n' "$label" "$count" "$([[ $count -eq 1 ]] || printf 's')"
  local result=0
  run_checks false || result=$?
  return "$result"
}

guard_pre_push() {
  local local_ref local_sha remote_ref remote_sha any=0
  GG_ROOT=$(repo_root) || { report_error repository "Run gg inside a Git working tree" 1; return 1; }
  cd "$GG_ROOT"
  # Git writes pre-push refs space-separated, but this script sets a global
  # IFS of newline+tab. Without restoring space here, the whole line lands in
  # local_ref, local_sha is empty, and every ref is silently skipped - the
  # guard then exits 0 on a repository full of secrets.
  while IFS=$' \t' read -r local_ref local_sha remote_ref remote_sha; do
    [[ -n "${local_sha:-}" ]] || continue
    if [[ "$local_sha" =~ ^0+$ ]]; then
      continue
    fi
    # What this push publishes is "reachable from this ref, and not already on any
    # remote" - in every case, so there is no new-branch/existing-branch split here.
    #
    # `$remote_sha..$local_sha` was wrong for the existing-branch case: it means
    # everything this push adds to THIS branch, so merging origin/main forward drags
    # every upstream commit the author never wrote into the scan. A false positive in
    # someone else's merged file then blocks the push, and the only way out is
    # --no-verify, which disables the real secret check too. That is how a guard
    # teaches people to bypass it.
    #
    # `--not --remotes` excludes what any remote already has: origin/main's history,
    # and this branch's previously-pushed commits. For a plain fast-forward push it is
    # identical to the old range. A merge commit contributes no files of its own to
    # `git log --name-only`, so the merged-in changes drop out with their commits.
    GG_BASE=""
    GG_LOCAL_REF=$local_ref
    GG_RANGE="$local_sha --not --remotes"
    GG_MODE=range
    GG_ALL_FILES=$(collect_files) || { report_error git "Could not select review files; verify the Git ref and pathspec" 1; return 1; }
    [[ -n "$GG_ALL_FILES" ]] || continue
    $GG_JSON || printf 'gg  guard pre-push  (%s)\n' "$local_ref"
    run_checks true || any=1
  done
  return "$any"
}

self_update() {
  GG_HOME="$GG_SELF_DIR" "${BASH:-bash}" "$GG_SELF_DIR/install.sh"
}

main() {
  local base_override=${GG_BASE:-}
  GG_MODE=branch
  GG_BASE=$base_override
  GG_RANGE=""
  GG_LOCAL_REF=""
  GG_PATHS=()

  # Recognize machine output even when an earlier argument is invalid.
  local option
  for option in "$@"; do
    [[ "$option" == -- ]] && break
    [[ "$option" == --json ]] && GG_JSON=true
  done
  local -a arguments=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json) GG_JSON=true; shift ;;
      --full) GG_FULL=true; shift ;;
      --timeout)
        [[ $# -ge 2 && "$2" =~ ^[1-9][0-9]*$ ]] || fail_usage '--timeout requires positive whole seconds'
        GG_TIMEOUT=$2; shift 2 ;;
      --) arguments+=("$@"); break ;;
      --staged|--since|--help|-h|--version|-V) arguments+=("$1"); shift ;;
      -*) fail_usage "unknown option: $1" ;;
      *) arguments+=("$1"); shift ;;
    esac
  done
  if [[ ${#arguments[@]} -gt 0 ]]; then set -- "${arguments[@]}"; else set --; fi
  if $GG_JSON; then command -v jq >/dev/null 2>&1 || { report_error dependency '--json requires jq; install jq and retry' 1; return 1; }; fi
  if [[ $# -eq 3 && "$1" == guard && "$2" == pre-push && ( "$3" == --help || "$3" == -h ) ]]; then
    set -- guard --help
  fi
  if [[ $# -eq 2 && ( "$2" == --help || "$2" == -h ) ]]; then
    case "$1" in
      setup) printf 'Usage: gg setup\nPrepare pinned analysis runners; never runs during review.\n'; return ;;
      self-update) printf 'Usage: gg self-update\nInstall latest stable release; refuse local modifications.\n'; return ;;
      guard) printf 'Usage: gg guard pre-push [-- <pathspec>...]\nRead Git pre-push refs on stdin; block findings or unavailable protection.\n'; return ;;
    esac
  fi
  case "${1:-}" in
    --help|-h)
      [[ $# -eq 1 ]] || fail_usage "--help takes no arguments"
      usage
      ;;
    --version|-V)
      [[ $# -eq 1 ]] || fail_usage "--version takes no arguments"
      printf 'gg %s (%s)\n' "$GG_VERSION" "$(git -C "$GG_SELF_DIR" rev-parse --short HEAD 2>/dev/null || printf unknown)"
      ;;
    --staged)
      if [[ $# -eq 1 ]]; then
        GG_PATHS=()
      elif [[ $# -eq 2 && $2 == -- ]]; then
        fail_usage "--staged requires at least one pathspec after --"
      elif [[ $# -ge 3 && $2 == -- ]]; then
        GG_PATHS=("${@:3}")
      else
        fail_usage "--staged pathspecs must follow --"
      fi
      GG_MODE=staged
      GG_BASE=""
      review
      ;;
    --since)
      [[ $# -eq 2 ]] || fail_usage "--since requires exactly one ref"
      GG_BASE=$2
      git rev-parse --verify --quiet "$GG_BASE" >/dev/null 2>&1 || fail_usage "unknown base ref: $GG_BASE"
      review
      ;;
    guard)
      [[ $# -ge 2 ]] || fail_usage "guard requires a hook name"
      [[ $2 == pre-push ]] || fail_usage "unsupported guard hook: $2"
      if [[ $# -eq 2 ]]; then
        GG_PATHS=()
      elif [[ $# -eq 3 && $3 == -- ]]; then
        fail_usage "guard pre-push requires at least one pathspec after --"
      elif [[ $# -ge 4 && $3 == -- ]]; then
        GG_PATHS=("${@:4}")
      else
        fail_usage "guard pre-push pathspecs must follow --"
      fi
      guard_pre_push
      ;;
    setup)
      [[ $# -eq 1 ]] || fail_usage "setup takes no arguments"
      operation setup "${BASH:-bash}" "$GG_SELF_DIR/setup.sh"
      ;;
    self-update)
      [[ $# -eq 1 ]] || fail_usage "self-update takes no arguments"
      operation self-update self_update
      ;;
    "")
      GG_BASE=$(resolve_base) || {
        if $GG_JSON; then printf '%s\n' '{"schema_version":1,"mode":"branch","checks":[],"summary":{"coverage_complete":false},"reason":"no base ref could be resolved","error":{"code":"baseline","message":"No base ref could be resolved"},"help":["gg --staged","gg --since <existing-ref>"]}'; else printf 'gg: no base ref could be resolved; nothing to review\nnext: gg --staged or gg --since <existing-ref>\n'; fi
        exit 1
      }
      review
      ;;
    -* ) fail_usage "unknown option: $1" ;;
    *)
      GG_MODE=paths
      GG_BASE=""
      GG_PATHS=("$@")
      review
      ;;
  esac
}

main "$@"
